# --- Required: Nebius Token Factory (https://tokenfactory.nebius.com) ---
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# --- Optional: Tavily web layer (https://app.tavily.com). Without it, URLs are fetched directly
#     and the "search" input mode is disabled. ---
TAVILY_API_KEY=

# --- Model routing. Leave blank to auto-resolve the Nemotron tiers from /v1/models. ---
# Fast tier: extraction, summarisation (thinking off)
RULESMITH_MODEL_FAST=
# Main tier: rule authoring and refinement
RULESMITH_MODEL_MAIN=
# Reasoning tier: planning and adversarial red-team (thinking on)
RULESMITH_MODEL_REASONING=

# --- Behaviour ---
RULESMITH_MAX_REFINE_ITERATIONS=3
RULESMITH_MAX_RULES=6
RULESMITH_ENABLE_REDTEAM=true
# Where run bundles are written
RULESMITH_RUNS_DIR=runs
# Set to "true" on the hosted demo so visitors can only use the bundled examples + replay
RULESMITH_DEMO_LOCKED=false
# Public live demo instead of locking: cap this process's Token Factory spend (USD, 0 = no cap) and rules per run.
RULESMITH_DEMO_BUDGET_USD=0
RULESMITH_DEMO_MAX_RULES=3
# Live runs per rolling hour on a public demo: for the whole process and per visitor address.
RULESMITH_DEMO_RUNS_PER_HOUR=12
RULESMITH_DEMO_RUNS_PER_IP_PER_HOUR=3
